# CDK deployment configuration

# Example values (set in your shell or CI secrets)
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# Backend container environment (optional)
OLLAMA_HOST=http://localhost:11434

# CDK parameters to provide (see `npx cdk deploy` prompts or `--parameters`)
# These are placeholders; you must replace with real values.
GITHUB_REPO=owner/repo
GITHUB_TOKEN_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:github-token
FIREBASE_SERVICE_ACCOUNT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:firebase-service-account
BEDROCK_FOUNDATION_MODEL_ARN=arn:aws:bedrock:us-east-1:123456789012:foundation-model/your-model-id

