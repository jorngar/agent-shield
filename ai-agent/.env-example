# Agent Shield wrapper configuration

# ── Agent selection ──────────────────────────────────────────────────────
# Which AI agent to wrap.  Overridable with `--agent <name>` on the CLI.
# Supported: codex, kilo, claude-code, openclaw, hermes-agent, geminicli
AGENT_SHIELD_AGENT=codex

# ── Ollama connection (local risk model) ─────────────────────────────────
AGENT_SHIELD_OLLAMA_HOST=http://localhost:11434
AGENT_SHIELD_OLLAMA_MODEL=qwen3.5:0.8b

# ── Backend approval API ────────────────────────────────────────────────
AGENT_SHIELD_BACKEND_URL=http://localhost:3000
# Example deployed API Gateway endpoint:
# AGENT_SHIELD_BACKEND_URL=https://n73h8lxc41.execute-api.ap-southeast-1.amazonaws.com

# ── Agent-specific command overrides ────────────────────────────────────
# Each adapter reads its own AGENT_SHIELD_<NAME>_COMMAND / _ARGS vars.
# Only override if the default binary isn't on PATH.

# Codex
AGENT_SHIELD_CODEX_COMMAND=codex
AGENT_SHIELD_CODEX_ARGS=-s read-only
# AGENT_SHIELD_CODEX_COMMAND=npx -y @openai/codex

# Kilo
# AGENT_SHIELD_KILO_COMMAND=kilo
# AGENT_SHIELD_KILO_ARGS=

# Claude Code
# AGENT_SHIELD_CLAUDE_CODE_COMMAND=claude
# AGENT_SHIELD_CLAUDE_CODE_ARGS=

# OpenClaw
# AGENT_SHIELD_OPENCLAW_COMMAND=openclaw

# Hermes
# AGENT_SHIELD_HERMES_COMMAND=hermes

# Gemini CLI
# AGENT_SHIELD_GEMINI_COMMAND=gemini

# ── Interception policy ─────────────────────────────────────────────────
# - mcp-targets:  intercept explicit MCP patterns + shell commands/connections that touch known MCP targets.
# - process-tree: intercept all non-whitelisted child processes plus all agent/child connections.
# - strict:       intercept all descendant shell process spawns and all connections.
AGENT_SHIELD_INTERCEPT_MODE=process-tree

# Process monitor scan interval in seconds (lower catches short-lived commands faster).
AGENT_SHIELD_PROCESS_SCAN_INTERVAL_SEC=0.1

# Log file path for interception/runtime logs (kept off TUI by default).
AGENT_SHIELD_LOG_FILE=.agent-shield.log

# ── Agent-specific API host overrides ───────────────────────────────────
# Per-agent API hosts are auto-detected; override only if needed.
# AGENT_SHIELD_RESPONSES_API_HOSTS=api.openai.com
# AGENT_SHIELD_KILO_API_HOSTS=
# AGENT_SHIELD_OPENCLAW_API_HOSTS=
# AGENT_SHIELD_HERMES_API_HOSTS=

# ── Whitelist (avoid self-block loops) ──────────────────────────────────
# - Hosts and command patterns are case-insensitive.
# - Command patterns are substring matches.
# Backend/Ollama endpoints are auto-whitelisted; only add extras if needed.
# AGENT_SHIELD_WHITELIST_HOSTS=
# AGENT_SHIELD_WHITELIST_PORTS=
# AGENT_SHIELD_WHITELIST_COMMAND_PATTERNS=ollama,localhost:11434

# ── Local-only mode ─────────────────────────────────────────────────────
# Skip backend entirely — use local LLM + policy triage only.
# Set to 1/true/yes to enable, or use --local-only on CLI.
AGENT_SHIELD_LOCAL_ONLY=false

# Port for the local dashboard (used with --local-only --dashboard).
AGENT_SHIELD_LOCAL_DASHBOARD_PORT=3200

# What to do when cloud review is unavailable (or in local-only mode):
# "approve" = fail open, "deny" = fail closed.
AGENT_SHIELD_CLOUD_REVIEW_FAILURE_MODE=approve

# ── Vulnerability scanning ───────────────────────────────────────────────
# Enable startup scan of agent dependencies for known CVEs (via local LLM).
# Set to 0/false/no to disable.
AGENT_SHIELD_VULN_SCAN=true
